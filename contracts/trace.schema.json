{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackalem.local/contracts/trace.schema.json",
  "title": "TurnTrace",
  "description": "Трассировка одного хода. Первые 9 полей это формат README кейса один в один, остальные наши.",
  "type": "object",
  "required": [
    "turn",
    "transcript",
    "language",
    "scenarios",
    "alternatives",
    "reason",
    "slots",
    "actions",
    "latency_ms",
    "decision",
    "response_language",
    "response_text",
    "catalog_version"
  ],
  "properties": {
    "turn": {
      "type": "integer",
      "minimum": 1
    },
    "transcript": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "kk",
        "mixed"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "confidence"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "enum": [
              "SC01",
              "SC02",
              "SC03",
              "SC04",
              "SC05",
              "SC06",
              "SC07",
              "SC08",
              "SC09",
              "SC10",
              "SC11",
              "SC12",
              "SC13",
              "SC14",
              "SC15",
              "SC16",
              "SC17",
              "SC18",
              "SC19",
              "SC20",
              "SC21",
              "SC22",
              "SC23",
              "SC24",
              "SC25",
              "SC26",
              "SC27",
              "SC28",
              "SC29",
              "SC30",
              "SC31",
              "SC32",
              "SC33",
              "SC34",
              "SC35",
              "SC36",
              "SC37",
              "SC38",
              "SC39",
              "SC40",
              "SYS_OUT_OF_SCOPE",
              "SYS_UNCLEAR",
              "SYS_GOODBYE"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "name": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "boundary_rule": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "confidence"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "enum": [
              "SC01",
              "SC02",
              "SC03",
              "SC04",
              "SC05",
              "SC06",
              "SC07",
              "SC08",
              "SC09",
              "SC10",
              "SC11",
              "SC12",
              "SC13",
              "SC14",
              "SC15",
              "SC16",
              "SC17",
              "SC18",
              "SC19",
              "SC20",
              "SC21",
              "SC22",
              "SC23",
              "SC24",
              "SC25",
              "SC26",
              "SC27",
              "SC28",
              "SC29",
              "SC30",
              "SC31",
              "SC32",
              "SC33",
              "SC34",
              "SC35",
              "SC36",
              "SC37",
              "SC38",
              "SC39",
              "SC40",
              "SYS_OUT_OF_SCOPE",
              "SYS_UNCLEAR",
              "SYS_GOODBYE"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "name": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "boundary_rule": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "slots": {
      "type": "object",
      "description": "слоты, извлечённые из этой реплики",
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+(:preview|:error)?$"
      },
      "description": "find_client, book_appointment:preview, get_claim:error"
    },
    "latency_ms": {
      "type": "object",
      "required": [
        "stt",
        "triage",
        "router",
        "response",
        "tts_first_audio",
        "total"
      ],
      "properties": {
        "stt": {
          "type": "integer",
          "minimum": 0
        },
        "triage": {
          "type": "integer",
          "minimum": 0
        },
        "router": {
          "type": "integer",
          "minimum": 0
        },
        "response": {
          "type": "integer",
          "minimum": 0
        },
        "tts_first_audio": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "run",
        "continue",
        "confirm",
        "cancel",
        "clarify",
        "handoff",
        "out_of_scope",
        "goodbye"
      ]
    },
    "response_language": {
      "type": "string",
      "enum": [
        "ru",
        "kk"
      ]
    },
    "response_text": {
      "type": "string"
    },
    "response_source": {
      "type": "string",
      "enum": [
        "template",
        "llm",
        "kb_template"
      ]
    },
    "fast_path": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "slot_pattern",
        "yes_no",
        "operator_request",
        "goodbye_word",
        "fast_path_scenario",
        null
      ]
    },
    "speculative_hit": {
      "type": "boolean"
    },
    "second_opinion": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scenario_id",
              "confidence"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "enum": [
                  "SC01",
                  "SC02",
                  "SC03",
                  "SC04",
                  "SC05",
                  "SC06",
                  "SC07",
                  "SC08",
                  "SC09",
                  "SC10",
                  "SC11",
                  "SC12",
                  "SC13",
                  "SC14",
                  "SC15",
                  "SC16",
                  "SC17",
                  "SC18",
                  "SC19",
                  "SC20",
                  "SC21",
                  "SC22",
                  "SC23",
                  "SC24",
                  "SC25",
                  "SC26",
                  "SC27",
                  "SC28",
                  "SC29",
                  "SC30",
                  "SC31",
                  "SC32",
                  "SC33",
                  "SC34",
                  "SC35",
                  "SC36",
                  "SC37",
                  "SC38",
                  "SC39",
                  "SC40",
                  "SYS_OUT_OF_SCOPE",
                  "SYS_UNCLEAR",
                  "SYS_GOODBYE"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "name": {
                "type": "string"
              },
              "segment": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "boundary_rule": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "agreed": {
          "type": "boolean"
        }
      }
    },
    "router_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_version": {
      "type": "string"
    },
    "active_scenario": {
      "type": [
        "string",
        "null"
      ]
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emotion": {
      "type": "string"
    },
    "urgency": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "phone",
        "text"
      ]
    },
    "interrupted": {
      "type": "boolean"
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}