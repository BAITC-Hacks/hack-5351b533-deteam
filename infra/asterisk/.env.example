# Run scripts/setup.ps1 to generate real secrets.
AMI_SECRET=CHANGE_ME
ARI_SECRET=CHANGE_ME
SIP_TEST_SECRET=CHANGE_ME
SIP_OPERATOR_SECRET=CHANGE_ME
MINIO_ROOT_USER=voicerouter
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
RECORDING_CALLBACK_BASE_URL=http://host.docker.internal:8000
RECORDING_CALLBACK_TOKEN=

# Set to the host's reachable LAN/public IP when calls cross Docker NAT.
# For a public SIP provider, use your public IP and forward SIP/RTP ports.
ASTERISK_PUBLIC_IP=
# "auto" uses the container IPv4 /32, so Docker's gateway is treated as external for SIP/RTP NAT.
ASTERISK_LOCAL_NET=auto

# IP address of the trusted local SIP server. Leave empty to disable IP trunk.
LOCAL_SIP_PEER_IP=
